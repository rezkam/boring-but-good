{
  "name": "ai-chat-skill",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "gemini-search"
  ],
  "scripts": {
    "test": "node --test test/*.mjs",
    "typecheck": "tsc --noEmit",
