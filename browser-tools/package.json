{
  "name": "@rezkam/browser-tools",
  "version": "0.2.0",
  "description": "Sandboxed, owner-token-protected Chrome automation for AI agents: control pages, record and review GIFs, capture HAR and raw CDP events, send CDP calls, and manage Chrome profiles.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezkam/boring-but-good.git",
    "directory": "browser-tools"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "browser-tools": "./bin/browser-tools.mjs"
  },
  "exports": {
    ".": "./scripts/browser-control.mjs",
    "./browser-control.mjs": "./scripts/browser-control.mjs",
    "./resource-helper.mjs": "./scripts/resource-helper.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage test/*.mjs",
    "validate": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "puppeteer-core": "^24.42.0"
  }
}
